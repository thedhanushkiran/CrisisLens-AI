# Local-only development configuration. Copy this file to .env and replace both
# tokens before use outside a single-developer machine. Never commit .env.
DATABASE_URL=sqlite:///./crisislens.db
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
VITE_API_BASE_URL=http://localhost:8000/api/v1
RESPONDER_API_TOKEN=change-this-local-responder-token
ADMIN_API_TOKEN=change-this-local-admin-token
RATE_LIMIT_PER_MINUTE=120
ENVIRONMENT=development
